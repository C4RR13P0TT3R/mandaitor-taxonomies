{
  "name": "mandaitor-taxonomies",
  "version": "2.0.1",
  "private": true,
  "description": "Community-contributed industry taxonomies for the Mandaitor delegation registry",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @mandaitor/taxonomy-core build && pnpm -r test",
    "lint": "pnpm --filter @mandaitor/taxonomy-core build && pnpm -r lint",
    "validate": "pnpm --filter @mandaitor/taxonomy-core build && node scripts/validate-all.mjs",
    "check:package-readmes": "node scripts/check-package-readmes.mjs",
    "clean": "pnpm -r clean",
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "new-taxonomy": "node scripts/scaffold-taxonomy.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "esbuild": ">=0.25.0"
    }
  }
}
