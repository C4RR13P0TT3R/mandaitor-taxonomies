{
  "name": "@mandaitor/taxonomy-defence-isr",
  "version": "1.0.0",
  "description": "Defence and ISR taxonomy for Mandaitor — intelligence analysis, mission authorization, kinetic decision support, sensor tasking, and escalation workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@mandaitor/taxonomy-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "mandaitor",
    "taxonomy",
    "defence",
    "isr",
    "intelligence",
    "delegation",
    "agentic-ai"
